@model EmployeesPortal.Models.Entities.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="container mt-5 d-flex justify-content-center">

    <div class="card shadow-lg border-0" style="width: 700px;">

        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">⚠ Confirm Employee Deletion</h4>
        </div>

        <div class="card-body">

            <div class="alert alert-warning">
                <strong>Warning!</strong> Are you sure you want to permanently delete this employee record?
            </div>

            <dl class="row mt-4">

                <dt class="col-sm-4 fw-semibold">Employee Name</dt>
                <dd class="col-sm-8">@Model.EmployeeName</dd>

                <dt class="col-sm-4 fw-semibold">Email</dt>
                <dd class="col-sm-8">@Model.Email</dd>

                <dt class="col-sm-4 fw-semibold">Department</dt>
                <dd class="col-sm-8">@Model.Department</dd>

                <dt class="col-sm-4 fw-semibold">Employee ID</dt>
                <dd class="col-sm-8">@Model.EmployeeId</dd>

                <dt class="col-sm-4 fw-semibold">Age</dt>
                <dd class="col-sm-8">@Model.Age</dd>

                <dt class="col-sm-4 fw-semibold">Phone Number</dt>
                <dd class="col-sm-8">@Model.PhoneNumber</dd>

                <dt class="col-sm-4 fw-semibold">Salary</dt>
                <dd class="col-sm-8">₹ @Model.Salary</dd>

            </dl>

            <hr />

            <form asp-action="DeleteEmployeeById" class="d-flex justify-content-between">
                <input type="hidden" asp-for="Id" />
                <a asp-action="EmployeesData" class="btn btn-outline-secondary btn-lg">
                    ← Back to List
                </a>
                <input type="submit" value="Delete Employee" class="btn btn-danger btn-lg px-4" />
            </form>
        </div>
    </div>
</div>
