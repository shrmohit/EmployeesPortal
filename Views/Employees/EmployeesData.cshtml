@model IEnumerable<EmployeesPortal.Models.Entities.Employee>

@{
    ViewData["Title"] = "Employees Data";
}

<div class="container mt-4">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Success!</strong> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-lg">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Employees List</h4>
            <a asp-action="CreateEmployee" class="btn btn-success">
                + Add New Employee
            </a>
        </div>

        <div class="card-body">

            <table class="table table-striped table-hover table-bordered align-middle text-center">
                <thead class="table-dark">
                    <tr>
                        <th>Email</th>
                        <th>Department</th>
                        <th>Employee ID</th>
                        <th>Age</th>
                        <th>Name</th>
                        <th>Phone</th>
                        <th>Salary</th>
                        <th style="width:220px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Email</td>
                            <td>@item.Department</td>
                            <td>@item.EmployeeId</td>
                            <td>@item.Age</td>
                            <td>@item.EmployeeName</td>
                            <td>@item.PhoneNumber</td>
                            <td>₹ @item.Salary</td>
                            <td>
                                <a asp-action="UpdateEmployee" asp-route-id="@item.Id" class="btn btn-sm " style="font-size: 18px;">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-action="EmployeeDetails" asp-route-id="@item.Id" class="btn btn-sm " style="font-size:18px;">
                                    <i class="bi bi-ticket-detailed"></i>
                                </a>
                                <a asp-action="DeleteEmployee" asp-route-id="@item.Id" class="btn btn-sm" style="font-size: 18px;">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>
