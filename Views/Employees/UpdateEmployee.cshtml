@model EmployeesPortal.Models.Entities.Employee

@{
    ViewData["Title"] = "Update Employee";
}

<div class="container mt-5 d-flex justify-content-center">

    <div class="card shadow-lg border-0" style="width: 850px;">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Update Employee Details</h4>
        </div>

        <div class="card-body px-4">

            <form asp-action="UpdateById">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="EmployeeName" class="form-label fw-semibold"></label>
                        <input asp-for="EmployeeName" class="form-control form-control-lg" />
                        <span asp-validation-for="EmployeeName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control form-control-lg" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label fw-semibold"></label>
                        <input asp-for="Department" class="form-control form-control-lg" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmployeeId" class="form-label fw-semibold"></label>
                        <input asp-for="EmployeeId" class="form-control form-control-lg" />
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Age" class="form-label fw-semibold"></label>
                        <input asp-for="Age" class="form-control form-control-lg" />
                        <span asp-validation-for="Age" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="PhoneNumber" class="form-control form-control-lg" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Salary" class="form-label fw-semibold"></label>
                        <input asp-for="Salary" class="form-control form-control-lg" />
                        <span asp-validation-for="Salary" class="text-danger small"></span>
                    </div>

                </div>

                <div class="mt-4 d-flex justify-content-between">
                    <a asp-action="EmployeesData" class="btn btn-outline-secondary btn-lg">
                        ← Back to List
                    </a>

                    <input type="submit" value="Save Changes" class="btn btn-primary btn-lg px-4" />
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
